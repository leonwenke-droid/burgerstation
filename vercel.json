{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/.well-known/:file", "destination": "/.well-known/:file" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
